{
  "name": "@pathscale/rollup-plugin-vue3",
  "version": "0.0.3",
  "description": "Rollup plugin for .vue files",
  "keywords": [
    "rollup",
    "rollup-plugin",
    "vue"
  ],
  "homepage": "https://github.com/pathscale/rollup-plugin-vue3#readme",
  "bugs": {
    "url": "https://github.com/pathscale/rollup-plugin-vue3/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pathscale/rollup-plugin-vue3.git"
  },
  "license": "MIT",
  "author": "Anton Kudryavtsev <boblobl4@gmail.com>",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "tsc": "tsc -p tsconfig-dev.json",
    "prebuild": "shx rm -rf dist",
    "build": "rollup -c --environment NODE_ENV:production",
    "commit": "commit",
    "predocs": "npm run build && shx rm -rf docs",
    "docs": "typedoc dist",
    "postdocs": "shx cp .ghpages.yml docs/_config.yml",
    "docs:publish": "npm run docs && gh-pages -d docs",
    "prelint": "prettier -l --write .",
    "lint": "eslint --ext .ts,.js,.mjs --fix .",
    "prepublishOnly": "npm run build",
    "release": "semantic-release",
    "pretest": "npm run lint",
    "test": "jest"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.1.4",
    "debug": "^4.4.0",
    "fs-extra": "^11.3.0",
    "query-string": "9.1.1",
    "resolve": "^1.22.10",
    "source-map": "^0.7.4",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-env": "^7.26.9",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-angular": "^19.8.0",
    "@commitlint/prompt-cli": "^19.8.0",
    "@eslint/js": "^9.23.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-typescript": "^12.1.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/debug": "^4.1.12",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "*",
    "@types/resolve": "^1.20.6",
    "@vue/compiler-sfc": "3.5.13",
    "builtin-modules": "^5.0.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-n": "^17.17.0",
    "eslint-plugin-unicorn": "^58.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "less": "^4.2.2",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "rollup": "^4.38.0",
    "rollup-plugin-dts": "^6.2.1",
    "rollup-plugin-node-externals": "^8.0.0",
    "sass": "^1.86.1",
    "scss": "^0.2.4",
    "semantic-release": "^24.2.3",
    "shx": "^0.4.0",
    "stylus": "^0.64.0",
    "ts-jest": "^29.3.1",
    "typedoc": "^0.28.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.0",
    "vue": "3.5.13"
  },
  "peerDependencies": {
    "@vue/compiler-sfc": "3.0.0-rc.5",
    "rollup": "^2.2.0"
  },
  "engines": {
    "node": "^20.11.0 || >=22.0.0"
  }
}
